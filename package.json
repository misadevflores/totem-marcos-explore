{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n SERVER,VITE -c cyan,green \"node server.js\" \"vite --port=3000 --host=0.0.0.0\"",
    "server": "node server.js",
    "build": "npm run generate-sqlite && vite build",
    "build:capacitor": "npm run generate-sqlite && VITE_BUILD_TARGET=capacitor vite build && npx cap copy android",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "generate-sqlite": "node scripts/generate-sqlite.js",
    "upload-pdfs": "node scripts/upload-pdfs-to-blob.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/blob": "^0.27.3",
    "@vercel/kv": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.2",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.8.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-static-copy": "^3.4.0"
  }
}
