# ══════════════════════════════════════════════════════════════════
# .env.example — Variables de entorno para MARCO Explorer Tótem
# Copia este archivo a .env.local y rellena los valores reales.
# ══════════════════════════════════════════════════════════════════

# ── Desarrollo local (Express + better-sqlite3) ────────────────────
# No necesitas configurar nada extra. npm run dev arranca todo.

# ── Override manual de la URL del backend (opcional) ──────────────
# VITE_API_BASE=http://localhost:3001/api   ← dev (por defecto)
# VITE_API_BASE=/api                        ← Vercel (auto-detectado)

# ── Vercel KV (para persistir leads entre invocaciones serverless) ─
# Obtén estos valores en: Vercel Dashboard → Storage → Create KV
KV_REST_API_URL=https://xxxxxxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KV_REST_API_READ_ONLY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Vercel Blob (para almacenar PDFs subidos desde el admin panel) ─
# Obtén este valor en: Vercel Dashboard → Storage → Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini AI (opcional — chatbot del tótem) ────────────────
VITE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
