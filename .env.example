# ══════════════════════════════════════════════════════════════════════════════
# MARCO EXPLORER — VARIABLES DE ENTORNO (.env)
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. CONTRASEÑA DE ADMINISTRADOR DEL TÓTEM
# ─────────────────────────────────────────────────────────────────────────────
VITE_ADMIN_PASSWORD="marco2026"

# ─────────────────────────────────────────────────────────────────────────────
# 2. BASE DE DATOS (LOCAL SQLITE vs ONLINE MYSQL/MARIADB)
# ─────────────────────────────────────────────────────────────────────────────
# DB_TYPE: 'sqlite' para modo local offline (por defecto) o 'mysql' para base remota online.
DB_TYPE=sqlite

# Opción A: URL completa de conexión a MySQL / MariaDB (Recomendado para Railway, Render, CleverCloud, etc.)
# MYSQL_URL="mysql://usuario:contraseña@servidor.remoto.com:3306/nombre_base_datos"

# Opción B: Parámetros individuales para MySQL / MariaDB remoto:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=totem_marco
# MYSQL_SSL: true si el servidor remoto requiere SSL/TLS (PlanetScale, TiDB, Aiven, AWS RDS)
MYSQL_SSL=false

# ─────────────────────────────────────────────────────────────────────────────
# 3. ENVÍO DE CORREOS AUTOMÁTICOS (SMTP) — ENVÍO DE PDFS A CLIENTES
# ─────────────────────────────────────────────────────────────────────────────
# Servidor SMTP (ejemplos: smtp.gmail.com | smtp.office365.com | mail.tudominio.com)
SMTP_HOST=smtp.gmail.com
# Puerto: 587 (STARTTLS - recomendado) o 465 (SSL)
SMTP_PORT=587
# SMTP_SECURE: false para puerto 587 / 25 | true para puerto 465
SMTP_SECURE=false
# Correo o usuario de autenticación SMTP
SMTP_USER=tu_correo@gmail.com
# Contraseña normal o Contraseña de Aplicación de 16 caracteres (para Gmail / Office 365)
SMTP_PASS=tu_contraseña_o_app_password
# Nombre y dirección de correo remitente que verá el cliente
SMTP_FROM="MARCO Explorer <tu_correo@gmail.com>"

# ─────────────────────────────────────────────────────────────────────────────
# 4. URL PÚBLICA DE LA APLICACIÓN (Para botones de descarga directa en correos y códigos QR)
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
